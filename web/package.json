{
  "name": "@podhub/web",
  "private": true,
  "type": "module",
  "scripts": {
    "dev": "vite --port 1420",
    "lint": "oxlint src/ --max-warnings 818",
    "wasm:build": "bash scripts/build-render.sh",
    "build": "bash ../scripts/check-wasm-dist.sh && tsc --noEmit -p tsconfig.json && vite build",
    "test": "bun test --preload ./tests/network-guard.preload.ts",
    "deadcode": "knip",
    "api:generate": "openapi-typescript ../api/openapi.yaml -o src/api/schema.d.ts",
    "api:check": "openapi-typescript ../api/openapi.yaml -o /tmp/schema.check.d.ts && diff -u src/api/schema.d.ts /tmp/schema.check.d.ts",
    "api:routes": "bun scripts/gen-routes.ts",
    "check": "bun run build && bun run test && bun run api:check && bun run deadcode && bun run lint"
  },
  "dependencies": {
    "@base-ui/react": "^1.6.0",
    "@dnd-kit/core": "^6.3.1",
    "@dnd-kit/sortable": "^10.0.0",
    "@dnd-kit/utilities": "^3.2.2",
    "@fontsource-variable/inter": "^5.3.0",
    "@noble/hashes": "2.0.1",
    "@tanstack/react-query": "^5.104.1",
    "class-variance-authority": "^0.7.1",
    "clsx": "^2.1.1",
    "echarts": "6.1.0",
    "lucide-react": "^1.28.0",
    "motion": "^14.4.0",
    "qrcode": "^1.5.4",
    "react": "^19.2.8",
    "react-dom": "^19.2.8",
    "tailwind-merge": "^3.6.0",
    "zustand": "^5.0.15"
  },
  "devDependencies": {
    "@shadcn/lint": "^0.1.0",
    "@tailwindcss/vite": "^4.3.3",
    "@types/node": "22.20.1",
    "@types/qrcode": "^1.5.6",
    "@types/react": "^19.2.18",
    "@types/react-dom": "^19.2.4",
    "@vitejs/plugin-react": "^6.0.5",
    "knip": "^6.35.1",
    "openapi-typescript": "6",
    "oxlint": "^1.83.0",
    "playwright-core": "1.49.1",
    "tailwindcss": "^4.3.3",
    "typescript": "^7.0.2",
    "vite": "^8.2.0"
  }
}
