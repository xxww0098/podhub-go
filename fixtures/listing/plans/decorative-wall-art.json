      "durability": {
        "intentBeforeDispatch": true,
        "idempotencyKey": "fixture:ozon.product-import:store-fixture-1:decor-001:revision-fixture-1",
        "effectScopeKey": "ozon.product@1:[\"store-fixture-1\",101]",
        "acceptedTaskIsTerminalSuccess": false,
        "resultUnknownRequiresReconciliation": true
