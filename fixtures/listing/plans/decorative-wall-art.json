      "config": {
        "descriptionCategoryId": 17027906,
        "typeId": 91976,
        "categoryPath": "住宅和花园 / 装饰和房间内饰 / 装饰画",
        "nameExpression": "{{ai.title}}",
        "descriptionExpression": "{{ai.description}}",
        "priceExpression": "1990",
