# Loopback only. This skeleton refuses any other database host.
# DATABASE_URL=postgres://postgres:postgres@127.0.0.1:5432/podhub?sslmode=disable

# Listen address. Rust's CLOUD_BIND default is 0.0.0.0:8080 (src/main.rs).
# This skeleton defaults to 127.0.0.1:8080.
# CLOUD_BIND=127.0.0.1:8080

# Parsed once, only in internal/config. Spellings match the Rust source.
#
# OZON_WRITE_KILL_SWITCH (src/store/egress.rs is_truthy):
#   1 / true / yes / on  -> Seller writes disabled
#   unset, empty, anything else -> writes stay enabled
#   This process still does not send when writes are enabled.
# OZON_WRITE_KILL_SWITCH=1
#
# CLOUD_MEDIA_GC_DELETE (src/media/slice_purge.rs enabled):
#   unset -> purge enabled
#   1 / true / on / yes -> purge enabled
#   0 / false / off / no -> purge disabled
#   any other value, including an empty string -> purge disabled, process still starts
# A non-UTF-8 value is also invalid and leaves the purge off.
# Deletes run only when the purge is enabled AND R2_ENDPOINT is
# http://127.0.0.1 or https://127.0.0.1 (port allowed, no userinfo).
# localhost, ::1, any other host, or a partial R2_* set is refused.
# CLOUD_MEDIA_GC_DELETE=0

# Fake bucket only. A real R2 host is refused while the purge is enabled.
# R2_ENDPOINT=http://127.0.0.1:9000
# R2_BUCKET=podhub-slices
# R2_ACCESS_KEY_ID=
# R2_SECRET_ACCESS_KEY=

# Load tests accept only Mode R (internal/loadtest). There is no other mode.
# PODHUB_LOADTEST_MODE=R

# Trace export (internal/platform/observability). Unset or blank: spans stay
# in process and nothing is dialed. A set value must be an http(s) URL on
# localhost, 127.0.0.1, or ::1, posted as OTLP/HTTP JSON. Any other value is
# logged and the exporter stays off; the process still starts.
# OTEL_EXPORTER_OTLP_TRACES_ENDPOINT=http://127.0.0.1:4318/v1/traces
